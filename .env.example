# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campstay?schema=public"

# Used to sign the short-lived access token (15 min)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"

# Used to sign the longer-lived refresh token (30 days)
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# The frontend origin allowed to call this API (CORS)
FRONTEND_URL="http://localhost:3000"

PORT=4000
NODE_ENV=development
